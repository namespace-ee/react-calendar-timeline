{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite-plus/test/globals", "@testing-library/jest-dom/vitest"],
    "paths": {
      "lib/*": ["./src/lib/*"],
      "test-utility": ["./__tests__/test-utility/index"],
      "test-utility/*": ["./__tests__/test-utility/*"]
    }
  },
  "include": ["__tests__/**/*", "__fixtures__/**/*", "src/**/*"]
}
