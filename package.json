{
  "name": "react-calendar-timeline",
  "version": "0.30.0-beta.19",
  "description": "react-calendar-timeline",
  "packageManager": "npm@10.1.0",
  "scripts": {
    "build": "vp pack",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "check": "vp check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test",
    "prepare": "vp config"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "sideEffects": false,
  "exports": {
    "./style.css": "./dist/style.css",
    "./dist/*.scss": "./dist/*.scss",
    "./dist/*.css": "./dist/*.css",
    ".": {
      "sass": "./dist/Timeline.scss",
      "style": "./dist/Timeline.css",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/namespace-ee/react-calendar-timeline",
  "repository": {
    "type": "git",
    "url": "https://github.com/namespace-ee/react-calendar-timeline.git"
  },
  "private": false,
  "author": "Marius Andra <marius.andra@gmail.com>",
